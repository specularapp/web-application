    "db:sync": "node scripts/db.mjs sync",
    "db:new": "node scripts/db.mjs new",
    "db:push": "node scripts/db.mjs push",
    "db:pull": "node scripts/db.mjs pull",
    "db:status": "node scripts/db.mjs status",
    "db:types": "node scripts/db.mjs types",
    "db:link": "node scripts/db.mjs link",
    "db:config-push": "node scripts/db.mjs config-push",
    "billing:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/probe-billing.mjs"
  },
