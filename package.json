    "@stripe/stripe-js": "^9.15.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^9.2.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
