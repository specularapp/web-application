# Endereco publico do site, sem barra no fim. Em desenvolvimento, http://localhost:3000; em producao, o
# dominio de verdade (https://app.specular.com.br). Um endereco local nunca vale em producao: o codigo o
# ignora e usa o dominio da Vercel ou o do produto.
NEXT_PUBLIC_APP_URL=http://localhost:3000
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Segredo de onde saem os tokens dos links publicos (orcamento, contrato, cobranca). Gere com
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SHARE_LINK_SECRET=
# Os dominios do portfolio no projeto da Vercel: com os dois, cadastrar e tirar um dominio na tela faz o mesmo
# na Vercel (que da o certificado). VERCEL_TEAM_ID so quando o projeto e de um time. Sem eles, cada dominio
# precisa ser adicionado a mao no painel da Vercel.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
